# ============================================================================
# WAN (geo-distributed) 5-node testnet configuration
# ============================================================================
#
# Copy this file to docker/.env on each node, then edit the per-node
# variables (NODE_ID, BOOTSTRAP_NODES, KEY_DIR).  The shared variables
# (JWT_SECRET, LANE0_VALIDATORS, TOTAL_NODES) must be IDENTICAL on
# every node — use scripts/setup-validators.sh on the bootstrap host to
# generate them once and scp them to the others.
#
# See docs/operations/geo-testnet.md for the full runbook.

# ---------------------------------------------------------------------------
# REQUIRED — shared across all nodes (set once, copy everywhere)
# ---------------------------------------------------------------------------

# HMAC-SHA256 secret for signing/verifying API JWTs.
# Generate: openssl rand -hex 32
# MUST be the same value on every node in the testnet.
OMNIA_JWT_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32

# Lane 0 static validator set (ADR-025).
# Format: hex64_pubkey:stake,hex64_pubkey:stake,...
# Generated by: NODES=5 ./scripts/setup-validators.sh
# MUST be byte-identical on every node — a mismatch silently breaks
# finality (acks are rejected as "unknown validator").
OMNIA_LANE0_VALIDATORS=REPLACE_ME_WITH_output_from_setup_validators_sh

# Total number of validators in the network.
# Must match the actual number of nodes running.
OMNIA_TOTAL_NODES=5

# Ed25519 public key (64 hex chars) authorised to mint on the financial
# shard.  Like OMNIA_LANE0_VALIDATORS this is a shared genesis parameter and
# MUST be byte-identical on every node — it is not this node's own key.
#
# Leaving it empty does not fall back to anything: minting is disabled, and
# /api/v1/supply and /api/v1/treasury/* report zeros.  Those endpoints serve
# unauthenticated, so on a public deployment an empty value reads as a broken
# economy rather than a disabled one.  Set it deliberately, either way.
OMNIA_MINT_AUTHORITY=

# ---------------------------------------------------------------------------
# PER-NODE — edit these on each host (unique per node)
# ---------------------------------------------------------------------------

# Unique integer for this node.  1 = bootstrap, 2-5 = dialers.
OMNIA_NODE_ID=1

# Bootstrap address.  Empty on the bootstrap node (A).
# On all other nodes, set to A's public QUIC endpoint.
OMNIA_BOOTSTRAP_NODES=

# Host path to this node's Ed25519 key directory.
# Generated by setup-validators.sh, copied via scp.
# Container runs as uid 1000 — chown -R 1000:1000 the key dir.
OMNIA_KEY_DIR=../ops/testnet-keys/node0

# ---------------------------------------------------------------------------
# OPTIONAL — defaults are fine for most deployments
# ---------------------------------------------------------------------------

# Rate limit (requests/second per client IP).  Default: 10.
# Raise for benchmarks: 1000 or higher.
OMNIA_RATE_LIMIT_RPS=1000

# Comma-separated list of caller IDs allowed to invoke privileged
# operations (MintUbc, AdvanceEpoch).  The admin caller from the
# benchmark scripts.
OMNIA_AUTHORIZED_CALLERS=admin-caller

# ---------------------------------------------------------------------------
# NOT used by docker-compose.wan.yml (included for reference)
# ---------------------------------------------------------------------------

# Grafana admin password — only used by the monitoring compose files.
#GRAFANA_ADMIN_PASSWORD=change-me
