# Omnia external validator environment sample
# Copy to docker/.env and replace all EXAMPLE values. Never commit real secrets.

OMNIA_NODE_ID=42
OMNIA_CONFIG_FILE=../config/external-validator.toml
OMNIA_NODE_KEY_FILE=/secure/omnia/node_key.bin
OMNIA_LISTEN_ADDR=/ip4/0.0.0.0/udp/4001/quic-v1
OMNIA_BOOTSTRAP_NODES=/dns4/bootstrap-1.example.net/udp/4001/quic-v1/p2p/12D3KooWEXAMPLEBOOTSTRAP1,/ip4/203.0.113.20/udp/4001/quic-v1/p2p/12D3KooWEXAMPLEBOOTSTRAP2
OMNIA_LANE0_VALIDATORS=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:1,bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb:1,cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:1
OMNIA_JWT_SECRET=replace-with-at-least-32-random-bytes-base64-or-hex
OMNIA_AUTHORIZED_CALLERS=operator-admin
OMNIA_RATE_LIMIT_RPS=10
OMNIA_HTTP_BIND=127.0.0.1
# OMNIA_MINT_AUTHORITY=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
